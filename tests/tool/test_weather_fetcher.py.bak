import unittest
from unittest.mock import patch, MagicMock
import json
from datetime import datetime, timedelta
import sys
import os
import sqlite3
import requests
import time
import tempfile

# 添加项目根目录到Python路径
sys.path.append(os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__)))))

from app.tool.weather_fetcher import WeatherFetcher

class TestWeatherFetcher(unittest.TestCase):
    def setUp(self):
        """测试前的准备工作"""
        # 使用临时文件存储数据库
        self.temp_dir = tempfile.mkdtemp()
        self.test_db = os.path.join(self.temp_dir, "test_weather_cache.db")
        self.config = {"cache_db": self.test_db}
        
        self.fetcher = WeatherFetcher(self.config)
        
        # 测试数据
        self.test_locations = [
            {"name": "京都", "coordinates": (35.0116, 135.768)},
            {"name": "奈良公园", "coordinates": (34.6851, 135.805)}
        ]
        self.test_date_range = ("2024-04-20", "2024-04-21")
        
        # 模拟API响应数据
        self.mock_api_response = {
            "daily": {
                "weathercode": [0],
                "temperature_2m_max": [22.5],
                "temperature_2m_min": [15.2],
                "precipitation_probability_max": [15],
                "uv_index_max": [4]
            }
        }
        
    def tearDown(self):
        """测试后的清理工作"""
        # 关闭所有数据库连接
        self.fetcher = None
        
        # 等待一小段时间确保文件句柄被释放
        time.sleep(0.1)
        
        # 删除临时目录及其内容
        try:
            if os.path.exists(self.temp_dir):
                for root, dirs, files in os.walk(self.temp_dir, topdown=False):
                    for name in files:
                        try:
                            file_path = os.path.join(root, name)
                            if os.path.exists(file_path):
                                os.chmod(file_path, 0o777)  # 确保有删除权限
                                os.remove(file_path)
                        except Exception as e:
                            print(f"无法删除文件 {name}: {str(e)}")
                    for name in dirs:
                        try:
                            dir_path = os.path.join(root, name)
                            if os.path.exists(dir_path):
                                os.rmdir(dir_path)
                        except Exception as e:
                            print(f"无法删除目录 {name}: {str(e)}")
                try:
                    if os.path.exists(self.temp_dir):
                        os.rmdir(self.temp_dir)
                except Exception as e:
                    print(f"无法删除临时目录: {str(e)}")
        except Exception as e:
            print(f"清理临时目录时出错: {str(e)}")
            
    def test_init(self):
        """测试初始化"""
        self.assertIsNotNone(self.fetcher)
        self.assertEqual(self.fetcher.base_url, "https://api.open-meteo.com/v1/forecast")
        self.assertEqual(self.fetcher.cache_db, self.test_db)
        self.assertEqual(self.fetcher.max_retries, 3)
        
    def test_weather_codes(self):
        """测试天气代码转换"""
        self.assertEqual(self.fetcher.weather_codes[0], "晴")
        self.assertEqual(self.fetcher.weather_codes[61], "小雨")
        self.assertEqual(self.fetcher.weather_codes[95], "雷雨")
        
    def test_uv_index_levels(self):
        """测试紫外线指数等级"""
        self.assertEqual(self.fetcher.uv_index_levels[(0, 2)], "低")
        self.assertEqual(self.fetcher.uv_index_levels[(3, 5)], "中")
        self.assertEqual(self.fetcher.uv_index_levels[(6, 7)], "高")
        self.assertEqual(self.fetcher.uv_index_levels[(8, 10)], "极高")
        
    @patch('requests.get')
    def test_get_weather_data(self, mock_get):
        """测试获取天气数据"""
        # 设置模拟响应
        mock_response = MagicMock()
        mock_response.json.return_value = {
            "daily": {
                "weathercode": [0],
                "temperature_2m_max": [22.5],
                "temperature_2m_min": [15.2],
                "precipitation_probability_max": [15],
                "uv_index_max": [4]
            }
        }
        mock_response.raise_for_status = MagicMock()
        mock_get.return_value = mock_response
        
        # 测试获取天气数据
        location = self.test_locations[0]["name"]
        date = self.test_date_range[0]
        weather_data = self.fetcher._get_weather_data(location, date)
        
        # 验证结果
        self.assertIsNotNone(weather_data)
        self.assertEqual(weather_data["temp"], (15.2, 22.5))
        self.assertEqual(weather_data["condition"], "晴")
        self.assertEqual(weather_data["rain_prob"], 0.15)
        self.assertEqual(weather_data["uv_index"], 4)
        
        # 验证缓存
        cached_data = self.fetcher._get_cached_data(location, date)
        self.assertIsNotNone(cached_data)
        self.assertEqual(cached_data["temp"], weather_data["temp"])
        
        # 验证 API 调用参数
        mock_get.assert_called_once()
        call_args = mock_get.call_args[1]
        self.assertIn("params", call_args)
        params = call_args["params"]
        self.assertIn("latitude", params)
        self.assertIn("longitude", params)
        self.assertIn("daily", params)
    def test_get_sunrise_sunset(self):
        """测试日出日落时间计算"""
        sunrise, sunset = self.fetcher._get_sunrise_sunset(
            self.test_locations[0]["coordinates"],
            self.test_date_range[0]
        )
        
        # 验证时间格式
        self.assertRegex(sunrise, r"^\d{2}:\d{2}$")
        self.assertRegex(sunset, r"^\d{2}:\d{2}$")
        
    def test_generate_weather_summary(self):
        """测试天气简报生成"""
        # 创建测试数据
        test_data = {
            "京都": {
                "2024-04-20": {
                    "temp": (15, 22),
                    "condition": "晴",
                    "rain_prob": 0.15,
                    "uv_index": 4,
                    "sunrise": "05:12",
                    "sunset": "18:23"
                }
            }
        }
        
        summary = self.fetcher.generate_weather_summary(test_data)
        
        # 验证简报格式
        self.assertIn("☀️", summary)
        self.assertIn("2024-04-20", summary)
        self.assertIn("晴", summary)
        self.assertIn("22℃", summary)
        self.assertIn("15%", summary)
        
    def test_get_tool_description(self):
        """测试工具描述"""
        description = self.fetcher.get_tool_description()
        
        # 验证描述格式
        self.assertEqual(description["name"], "weather_fetcher")
        self.assertIn("获取指定地点", description["description"])
        self.assertIn("locations", description["parameters"]["properties"])
        self.assertIn("date_range", description["parameters"]["properties"])
        
    def test_retry_mechanism(self):
        """测试重试机制"""
        # 设置模拟响应，前两次失败，第三次成功
        with patch('requests.get') as mock_get:
            mock_response = MagicMock()
            mock_response.json.return_value = self.mock_api_response
            mock_response.raise_for_status = MagicMock()
            
            mock_error_response = MagicMock()
            mock_error_response.raise_for_status.side_effect = requests.exceptions.RequestException("网络错误")
            
            mock_get.side_effect = [
                mock_error_response,
                mock_error_response,
                mock_response
            ]
            
            # 测试获取天气数据
            weather_data = self.fetcher._get_weather_data(
                self.test_locations[0],
                self.test_date_range[0]
            )
            
            # 验证重试次数
            self.assertEqual(mock_get.call_count, 3)
            self.assertIsNotNone(weather_data)
            
    def test_cache_mechanism(self):
        """测试缓存机制"""
        # 准备测试数据
        test_data = {
            "temp": (15, 22),
            "condition": "晴",
            "rain_prob": 0.15,
            "uv_index": 4,
            "sunrise": "05:12",
            "sunset": "18:23"
        }
        
        # 保存到缓存
        self.fetcher._save_to_cache(
            self.test_locations[0]["name"],
            self.test_date_range[0],
            test_data
        )
        
        # 从缓存获取
        cached_data = self.fetcher._get_cached_data(
            self.test_locations[0]["name"],
            self.test_date_range[0]
        )
        
        # 验证缓存数据
        self.assertIsNotNone(cached_data)
        self.assertEqual(cached_data["temp"], test_data["temp"])
        self.assertEqual(cached_data["condition"], test_data["condition"])
        
    @patch('requests.get')
    def test_get_weather_report(self, mock_get):
        """测试获取完整天气报告"""
        # 设置模拟响应
        mock_response = MagicMock()
        mock_response.json.return_value = self.mock_api_response
        mock_get.return_value = mock_response
        
        # 获取天气报告
        report = self.fetcher.get_weather_report(
            self.test_locations[:1],  # 只测试一个地点
            self.test_date_range
        )
        
        # 验证报告格式和内容
        self.assertIn("京都", report)
        self.assertIn(self.test_date_range[0], report["京都"])
        self.assertIn(self.test_date_range[1], report["京都"])
        
        # 验证数据结构
        day_data = report["京都"][self.test_date_range[0]]
        self.assertIn("temp", day_data)
        self.assertIn("condition", day_data)
        self.assertIn("rain_prob", day_data)
        self.assertIn("uv_index", day_data)
        self.assertIn("sunrise", day_data)
        self.assertIn("sunset", day_data)
        
        # 验证数据类型
        self.assertIsInstance(day_data["temp"], tuple)
        self.assertIsInstance(day_data["condition"], str)
        self.assertIsInstance(day_data["rain_prob"], float)
        self.assertIsInstance(day_data["uv_index"], (int, float))
        self.assertIsInstance(day_data["sunrise"], str)
        self.assertIsInstance(day_data["sunset"], str)
        
    def test_invalid_coordinates(self):
        """测试无效坐标处理"""
        # 测试无效坐标
        invalid_location = {"name": "无效地点", "coordinates": (91, 181)}  # 超出有效范围的坐标
        
        with self.assertRaises(ValueError):
            self.fetcher._get_sunrise_sunset(invalid_location["coordinates"], self.test_date_range[0])
            
    def test_database_error_handling(self):
        """测试数据库错误处理"""
        # 创建一个损坏的数据库文件
        with open(self.test_db, 'w') as f:
            f.write("This is not a valid SQLite database")
            
        # 创建新的 WeatherFetcher 实例，它应该能够处理损坏的数据库
        try:
            self.fetcher = None  # 确保之前的实例被清理
            time.sleep(0.1)  # 等待文件句柄释放
            
            # 应该抛出 sqlite3.DatabaseError
            with self.assertRaises(sqlite3.DatabaseError):
                WeatherFetcher(self.config)
                
        except Exception as e:
            self.fail(f"数据库错误处理失败: {str(e)}")
            
        # 验证损坏的数据库文件已被删除
        self.assertFalse(os.path.exists(self.test_db))

if __name__ == '__main__':
    unittest.main() 